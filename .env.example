# Copy these into Hostinger → Node.js app → Environment variables (or a local .env).
# Every value is optional — empty values are simply hidden on the site.

NODE_ENV=production
SITE_URL=https://selindental.com

# Contact
CONTACT_WHATSAPP=          # digits only, international, e.g. 201001234567
CONTACT_PHONE=             # display, e.g. +20 100 123 4567
CONTACT_EMAIL=
ADDRESS_EN=
ADDRESS_AR=
HOURS_EN=By appointment · Saturday – Thursday
HOURS_AR=بموعد مسبق · من السبت إلى الخميس
MAP_EMBED_URL=             # Google Maps → Share → Embed a map → the iframe "src"
MAP_LINK=                  # Google Maps → Share → link

# Local SEO (schema.org)
ADDRESS_STREET=
ADDRESS_CITY=
ADDRESS_REGION=
ADDRESS_POSTAL=
ADDRESS_COUNTRY=EG
GEO_LAT=
GEO_LNG=
OPENING_HOURS=             # e.g. Sa-Th 12:00-22:00
PRICE_RANGE=$$$

# Google Business Profile ★
GOOGLE_BUSINESS_URL=
GOOGLE_REVIEW_URL=
GOOGLE_RATING=             # your real current rating, e.g. 4.9
GOOGLE_RATING_COUNT=       # your real review count, e.g. 127
GOOGLE_SITE_VERIFICATION=

# Social
SOCIAL_INSTAGRAM=https://www.instagram.com/selindental
SOCIAL_INSTAGRAM_HANDLE=@selindental
SOCIAL_FACEBOOK=
SOCIAL_TIKTOK=

# Booking e-mails (optional — bookings are always saved to data/bookings.ndjson)
SMTP_HOST=                 # Hostinger mail: smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
BOOKING_EMAIL_TO=
BOOKING_EMAIL_FROM=
