<%- include('partials/head') %>
<%- include('partials/pagehero', { label: s('tour.label'), heading: s('tour.title'), sub: s('clinic.page.sub') }) %>

<section class="sec sec--dark clinic-film">
  <div class="wrap clinic-film-grid">
    <div class="clinic-phone" data-lightbox-open role="button" tabindex="0" data-cursor="<%= s('film.play') %>" aria-label="<%= s('hero.film') %>">
      <video src="/media/selin-promo-720.mp4" poster="/media/poster.jpg" muted loop playsinline preload="none" data-autoplay-visible></video>
    </div>
    <div>
      <p class="eyebrow"><span class="spark"></span><%= s('film.label') %></p>
      <h2 class="display h2"><%= s('film.title') %></h2>
      <p class="lede"><%= s('tour.sub') %></p>
      <button class="btn btn--gold magnetic" type="button" data-lightbox-open><span class="play-ico" aria-hidden="true"></span><span><%= s('film.play') %></span></button>
    </div>
  </div>
</section>

<section class="sec sec--pearl">
  <div class="wrap masonry">
    <% const frames = ['t01','t02','t03','t04','t05','t06','t07','t08','t09','t10','t11','t12','t13','t14','t15','t16','t17','t18','t19']; %>
    <% frames.forEach(function (f, i) { const lab = content.tour.find(x => x.src.includes(f)); %>
      <figure class="masonry-item reveal">
        <img src="/media/tour/<%= f %>.jpg" alt="SÉLIN Dental Aesthetics — <%= lab ? t(lab.label) : 'clinic' %>" loading="lazy" decoding="async">
        <% if (lab) { %><figcaption><%= t(lab.label) %></figcaption><% } %>
      </figure>
    <% }) %>
  </div>
</section>

<%- include('partials/cta') %>
<%- include('partials/foot') %>
