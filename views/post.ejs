<%- include('partials/head') %>

<article class="post">
  <header class="post-hero sec--dark">
    <div class="wrap post-hero-grid">
      <div>
        <p class="eyebrow hero-in"><a class="ulink" href="<%= link('/blog') %>"><%= s('blog.label') %></a> <span class="spark"></span> <%= t(post.category) %></p>
        <h1 class="display post-title split-lines"><%= t(post.title) %></h1>
        <p class="lede hero-in"><%= t(post.excerpt) %></p>
        <div class="post-byline hero-in">
          <% if (author) { %>
          <span class="post-av" aria-hidden="true"><%= author.initials %></span>
          <span>
            <span class="post-by"><%= s('blog.by') %> <a class="ulink" href="<%= link('/doctors') %>" rel="author"><strong><%= t(author.name) %></strong></a></span>
            <span class="post-dates"><time datetime="<%= post.date %>"><%= fmtDate(post.date) %></time> · <%= post.readMins %> <%= s('blog.min') %><% if (post.updated && post.updated !== post.date) { %> · <%= s('blog.updated') %> <time datetime="<%= post.updated %>"><%= fmtDate(post.updated) %></time><% } %></span>
          </span>
          <% } %>
        </div>
      </div>
      <div class="post-cover hero-in"><img src="<%= post.image %>" alt="<%= t(post.title) %>" decoding="async" fetchpriority="high"></div>
    </div>
  </header>

  <div class="sec sec--pearl post-body-wrap">
    <div class="wrap">
      <%- include('partials/crumbs') %>
      <div class="post-layout">
        <aside class="post-aside">
          <div class="post-toc">
            <p class="eyebrow"><span class="spark"></span><%= s('blog.toc') %></p>
            <ol>
              <li><a href="#answer"><%= s('blog.short') %></a></li>
              <% post.sections.forEach(function (sec, i) { %><li><a href="#s<%= i + 1 %>"><%= t(sec.h) %></a></li><% }) %>
              <li><a href="#takeaways"><%= s('blog.takeaways') %></a></li>
              <% if (post.faq && post.faq.length) { %><li><a href="#faq"><%= s('blog.faq') %></a></li><% } %>
            </ol>
          </div>
          <% if (tr) { %>
          <a class="post-side-cta" href="<%= link('/treatments/' + tr.slug) %>">
            <img src="<%= tr.image %>" alt="" loading="lazy">
            <span class="eyebrow"><span class="spark"></span><%= s('blog.cta') %></span>
            <strong class="display"><%= t(tr.name) %></strong>
          </a>
          <% } %>
        </aside>

        <div class="post-content">
          <section class="answer" id="answer">
            <p class="eyebrow"><span class="spark"></span><%= s('blog.short') %></p>
            <p><%= t(post.answer) %></p>
          </section>

          <% post.sections.forEach(function (sec, i) { %>
            <section class="post-sec" id="s<%= i + 1 %>">
              <h2 class="display"><%= t(sec.h) %></h2>
              <% (sec.p || []).forEach(function (para) { %><p><%= t(para) %></p><% }) %>
              <% if (sec.list) { %><ul class="ticks"><% sec.list.forEach(function (li) { %><li><%= t(li) %></li><% }) %></ul><% } %>
            </section>
          <% }) %>

          <section class="takeaways" id="takeaways">
            <p class="eyebrow"><span class="spark"></span><%= s('blog.takeaways') %></p>
            <ul><% post.takeaways.forEach(function (k) { %><li><%= t(k) %></li><% }) %></ul>
          </section>

          <% if (post.faq && post.faq.length) { %>
          <section class="post-faq" id="faq">
            <h2 class="display"><%= s('blog.faq') %></h2>
            <div class="faq-list">
              <% post.faq.forEach(function (f) { %>
                <details class="faq-item" open><summary><span><%= t(f.q) %></span><i aria-hidden="true"></i></summary><div class="faq-a"><p><%= t(f.a) %></p></div></details>
              <% }) %>
            </div>
          </section>
          <% } %>

          <% if (author) { %>
          <section class="author-box">
            <span class="post-av post-av--lg" aria-hidden="true"><%= author.initials %></span>
            <div>
              <p class="eyebrow"><span class="spark"></span><%= s('blog.by') %> · <%= s('blog.reviewed') %></p>
              <h3 class="display"><%= t(author.name) %></h3>
              <p class="author-focus"><%= t(author.role) %> · <%= t(author.focus) %></p>
              <p><%= t(author.bio) %></p>
            </div>
          </section>
          <% } %>

          <p class="fine"><span class="spark"></span><%= s('blog.disclaimer') %></p>

          <div class="share">
            <span><%= s('blog.share') %></span>
            <a class="ulink" href="https://wa.me/?text=<%= encodeURIComponent(t(post.title) + ' ' + canonical) %>" target="_blank" rel="noopener">WhatsApp</a>
            <a class="ulink" href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(canonical) %>" target="_blank" rel="noopener">Facebook</a>
            <a class="ulink" href="https://x.com/intent/post?url=<%= encodeURIComponent(canonical) %>&text=<%= encodeURIComponent(t(post.title)) %>" target="_blank" rel="noopener">X</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</article>

<% if (more.length) { %>
<section class="sec sec--dust">
  <div class="wrap">
    <div class="sec-head sec-head--split">
      <h2 class="display h2"><%= s('blog.more') %></h2>
      <a class="btn btn--dark magnetic" href="<%= link('/blog') %>"><span><%= s('blog.all') %></span></a>
    </div>
    <div class="blog-grid">
      <% more.forEach(function (p) { %><%- include('partials/postcard', { p }) %><% }) %>
    </div>
  </div>
</section>
<% } %>

<%- include('partials/cta') %>
<%- include('partials/foot') %>
