<section class="phero sec--dark">
  <canvas class="stars" data-stars data-density=".7" aria-hidden="true"></canvas>
  <div class="phero-moon" aria-hidden="true"></div>
  <div class="wrap phero-inner">
    <%- include('crumbs') %>
    <p class="eyebrow hero-in"><span class="spark"></span><%= label %></p>
    <h1 class="display phero-title split-lines"><%= heading %></h1>
    <% if (typeof sub !== 'undefined' && sub) { %><p class="lede hero-in"><%= sub %></p><% } %>
  </div>
</section>
