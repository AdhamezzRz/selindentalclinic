  </main>

  <footer class="footer">
    <div class="footer-top">
      <div class="footer-brand">
        <%- include('mark') %>
        <p><%= s('footer.line') %></p>
      </div>
      <div class="footer-cols">
        <div>
          <h3><%= s('info.visit') %></h3>
          <% if (t(config.contact.address)) { %><p><%= t(config.contact.address) %></p><% } %>
          <% if (config.contact.mapLink) { %><p><a class="ulink" href="<%= config.contact.mapLink %>" target="_blank" rel="noopener"><%= s('info.directions') %></a></p><% } %>
          <p class="muted"><%= t(config.contact.hours) %></p>
        </div>
        <div>
          <h3><%= s('info.contact') %></h3>
          <% if (config.contact.phone) { %><p><a class="ulink" href="tel:<%= config.contact.phone.replace(/\s/g, '') %>" dir="ltr"><%= config.contact.phone %></a></p><% } %>
          <% if (config.contact.email) { %><p><a class="ulink" href="mailto:<%= config.contact.email %>"><%= config.contact.email %></a></p><% } %>
          <p><a class="ulink" href="<%= link('/book') %>"><%= s('nav.book') %></a></p>
        </div>
        <div>
          <h3><%= s('info.follow') %></h3>
          <% if (config.social.instagram) { %><p><a class="ulink" href="<%= config.social.instagram %>" target="_blank" rel="noopener" dir="ltr"><%= config.social.instagramHandle %></a></p><% } %>
          <% if (config.social.facebook) { %><p><a class="ulink" href="<%= config.social.facebook %>" target="_blank" rel="noopener">Facebook</a></p><% } %>
          <% if (config.social.tiktok) { %><p><a class="ulink" href="<%= config.social.tiktok %>" target="_blank" rel="noopener">TikTok</a></p><% } %>
        </div>
        <div>
          <h3>SÉLIN</h3>
          <p><a class="ulink" href="<%= link('/treatments') %>"><%= s('nav.treatments') %></a></p>
          <p><a class="ulink" href="<%= link('/cases') %>"><%= s('nav.cases') %></a></p>
          <p><a class="ulink" href="<%= link('/doctors') %>"><%= s('nav.doctors') %></a></p>
          <p><a class="ulink" href="<%= link('/clinic') %>"><%= s('nav.clinic') %></a></p>
          <p><a class="ulink" href="<%= link('/blog') %>"><%= s('nav.blog') %></a></p>
        </div>
      </div>
    </div>
    <div class="footer-giant" aria-hidden="true"><img src="/img/wordmark.svg" alt="" width="3080" height="1184" loading="lazy"></div>
    <div class="footer-bottom">
      <span>© <%= new Date().getFullYear() %> SÉLIN Dental Aesthetics. <%= s('footer.rights') %></span>
      <span class="footer-line"><%= content.doctors.map(d => t(d.name)).join(' · ') %></span>
      <a href="#main" class="ulink" data-top><%= s('footer.top') %> ↑</a>
    </div>
  </footer>

  <div class="lightbox" data-lightbox aria-hidden="true" role="dialog" aria-label="<%= s('film.title') %>">
    <button class="lightbox-close" type="button" data-lightbox-close aria-label="<%= s('nav.close') %>"><i></i><i></i></button>
    <div class="lightbox-frame">
      <video data-lightbox-video src="/media/selin-promo.mp4" poster="/media/poster.jpg" playsinline controls preload="none"></video>
    </div>
  </div>

  <nav class="dock" data-dock aria-label="<%= s('nav.book') %>">
    <a class="dock-main" href="<%= link('/book') %>"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3.5" y="5" width="17" height="15" rx="3"/><path d="M8 3v4M16 3v4M3.5 10h17"/></svg><span><%= s('nav.book') %></span></a>
    <% if (waLink()) { %><a class="dock-btn" href="<%= waLink(s('book.wa.msg')) %>" target="_blank" rel="noopener" aria-label="WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.1 5.1 0 0 0 1.1 2.7 11.6 11.6 0 0 0 4.4 3.9c1.6.7 2.3.8 3.1.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg><span>WhatsApp</span></a><% } %>
    <% if (config.contact.phone) { %><a class="dock-btn" href="tel:<%= config.contact.phone.replace(/\s/g, '') %>" aria-label="<%= s('dock.call') %>"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h3.5l1.7 4.3-2.2 1.4a11 11 0 0 0 6.3 6.3l1.4-2.2L20 15.5V19a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1Z"/></svg><span><%= s('dock.call') %></span></a><% } %>
  </nav>

  <% if (waLink()) { %>
  <a class="wa-float magnetic" href="<%= waLink(s('book.wa.msg')) %>" target="_blank" rel="noopener" aria-label="WhatsApp">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.1 5.1 0 0 0 1.1 2.7 11.6 11.6 0 0 0 4.4 3.9c1.6.7 2.3.8 3.1.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
  </a>
  <% } %>

  <script src="/vendor/gsap/gsap.min.js" defer></script>
  <script src="/vendor/gsap/ScrollTrigger.min.js" defer></script>
  <script src="/vendor/lenis/lenis.min.js" defer></script>
  <script src="/js/main.js?v=<%= v %>" defer></script>
</body>
</html>
