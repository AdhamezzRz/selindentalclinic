<article class="doc reveal">
  <div class="doc-portrait">
    <div class="doc-arch">
      <% if (d.photo) { %>
        <img src="<%= d.photo %>" alt="<%= t(d.name) %>" loading="lazy" decoding="async">
      <% } else { %>
        <div class="doc-mono" aria-hidden="true">
          <span class="doc-orbit"></span>
          <span class="doc-initials"><%= d.initials %></span>
          <%- include('mark') %>
        </div>
      <% } %>
    </div>
    <span class="doc-role"><%= t(d.role) %></span>
  </div>
  <div class="doc-body">
    <h3 class="doc-name display"><%= t(d.name) %></h3>
    <p class="doc-focus"><%= t(d.focus) %></p>
    <blockquote class="doc-quote">“<%= t(d.quote) %>”</blockquote>
    <% if (typeof full !== 'undefined' && full) { %><p class="doc-bio"><%= t(d.bio) %></p><% } %>
  </div>
</article>
