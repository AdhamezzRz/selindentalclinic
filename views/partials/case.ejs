<%
  const tr = content.treatments.find(x => x.slug === c.treatment);
  const isSim = !!c.sim && !(c.before && c.after);
%>
<article class="case" data-cat="<%= c.treatment %>">
  <figure class="ba" data-ba dir="ltr" <% if (isSim) { %>data-sim="<%= JSON.stringify(c.sim) %>"<% } %>>
    <div class="ba-layer ba-before">
      <% if (!isSim) { %><img src="<%= c.before %>" alt="<%= t(c.title) %> — <%= s('cases.before') %>" loading="lazy" decoding="async"><% } %>
    </div>
    <div class="ba-layer ba-after">
      <% if (!isSim) { %><img src="<%= c.after %>" alt="<%= t(c.title) %> — <%= s('cases.after') %>" loading="lazy" decoding="async"><% } %>
    </div>
    <div class="ba-line" aria-hidden="true"><span class="ba-moon"><i></i></span></div>
    <span class="ba-tag ba-tag--b"><%= s('cases.before') %></span>
    <span class="ba-tag ba-tag--a"><%= s('cases.after') %></span>
    <% if (isSim) { %><span class="ba-sim"><span class="spark"></span><%= s('cases.sim') %></span><% } %>
    <input class="ba-range" type="range" min="0" max="100" value="50" aria-label="<%= s('cases.before') %> / <%= s('cases.after') %> — <%= t(c.title) %>">
  </figure>
  <div class="case-meta">
    <p class="case-tr"><%= tr ? t(tr.name) : '' %></p>
    <h3 class="case-title"><%= t(c.title) %></h3>
    <p class="case-note"><span><%= t(c.note) %></span><span><%= t(c.visits) %></span></p>
  </div>
</article>
